{
  "expo": {
    "name": "NoRushApp",
    "slug": "NoRushApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "entryPoint": "./index.js",
    "icon": "./assets/images/icon.png",
    "scheme": "norushapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "경로 추천 서비스를 제공하기 위해 현재 위치 접근이 필요합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "대중교통 안내 중 백그라운드에서도 위치 추적을 허용합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "경로 안내를 위해 백그라운드 위치 접근이 필요합니다.",
          "locationWhenInUsePermission": "현재 위치 기반 서비스를 제공하기 위해 위치 접근을 허용합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}